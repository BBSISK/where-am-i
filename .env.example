# Public URL of the Where Am I TTS server (Phase 2), e.g. https://where-am-i-api.onrender.com
# This is NOT a secret. Never put an API key in a VITE_ variable: those are compiled into the public site.
# The ElevenLabs key is set only on the server (ELEVENLABS_API_KEY).
VITE_TTS_ENDPOINT=

# Logainm (Gaois) API key: used ONLY by the offline data pipeline (pipeline/), never by the app.
# Put the real value in .env (git-ignored) on your machine, or as a GitHub Actions secret.
LOGAINM_API_KEY=
